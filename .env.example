# Copy this file to .env and paste in your Neon connection string
# (Neon dashboard → your project → Connect → copy the "pooled" URL).
# It looks like: postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: get a free key at https://www.omdbapi.com/apikey.aspx to
# auto-fill IMDb ratings and poster art when you log a movie night.
# Leave blank to enter everything by hand instead.
OMDB_API_KEY=
